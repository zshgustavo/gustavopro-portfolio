# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca commite a chave.
#
# Necessária apenas para GERAR traduções (`npm run translate`).
# O build de produção NÃO precisa dela: sem a chave, o script apenas avisa quais
# arquivos estão desatualizados e mantém os `-en.md` já commitados.
GEMINI_API_KEY=

# Opcional — modelo usado na tradução PT → EN.
# Padrão: gemini-3.1-flash-lite
GEMINI_MODEL=
